<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>To Do</title>
  <link rel="stylesheet" href="/style.css">
</head>

<body>
  <nav>
    <h2>To-Do</h2>
    <a href="#">completed</a>
  </nav>
  
  <div class="tasks-container">
  </div>
  <form  action="/add" method="post" id="add-a-task-form">
    <input type="text" name="task" id="task" autofocus autocomplete="off" required>
    <button id="add-task" type="submit"><img src="/assets/add.png" alt="add icon"></button>

  </form>
  <script src="/script.js"></script>
</body>

</html>